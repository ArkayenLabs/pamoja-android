<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Points the debug build at a network security config that permits
  cleartext to the Firebase emulators on the host machine, so the
  emulator-backed integration tests can reach them. Release is unaffected.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>

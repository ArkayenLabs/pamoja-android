<?xml version="1.0" encoding="utf-8"?>
<!-- tools:ignore: a launcher inflates these RemoteViews without AppCompat, so
     the app: attributes lint suggests would be dropped there; the faces'
     descriptions are set in code, per face. -->
<!-- The group's streak on the lilac tile (mockup row B). Before a streak of
     two it shows this week's share of the goal instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint,UselessLeaf"
    android:id="@+id/widget_hook_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_hero"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_hook_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_flame"
        android:tint="@color/widget_on_hero" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_hook_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_on_hero"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_hook_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/widget_on_hero"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>

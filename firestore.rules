rules_version = '2';

// ============================================================================
// PAMOJA. FIRESTORE SECURITY RULES
// ============================================================================
// IMPORTANT: this is the FINAL Circle Preview rule set. Do not deploy it over
// an installed paid-history build by itself. The safe pre-launch sequence is:
// (1) deploy a temporary compatibility rule that adds groupPreviews reads but
// keeps completed weeks member-readable, (2) deploy the weekly finalizer,
// (3) distribute and verify the preview-enabled APK, then (4) deploy this final
// gate after every closed tester has updated. A public app would additionally
// need an enforced minimum supported version before tightening this boundary.
//
// ---------------------------------------------------------------------------
// Data model:
//   users/{userId}                  userId == Firebase Auth UID
//   groups/{groupId}                groupId == UUID v4
//   memberships/{userId}_{groupId}  fields: userId, groupId, role, canEditTarget, joinedAt
//   steps/{userId}_{date}           fields: userId, date, steps
//   groupAccess/{groupId}            server-owned paid feature lease
//   groupPreviews/{groupId}          server-owned one-time Circle Preview
//   pushRegistrations/{fid}          server-owned FCM installation mapping
//   groups/{groupId}/weeks/{date}    server-finalized completed-week history
//   groups/{groupId}/nextWeekPlans/{date} group Premium planning
//   groups/{groupId}/signals/{date}_{kind}_{from}_{to}  cheers and nudges
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupAdmin(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.adminId == request.auth.uid;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId));
    }

    function hasValidPaidGroupAccess(groupId) {
      let accessPath = /databases/$(database)/documents/groupAccess/$(groupId);
      return exists(accessPath)
        && get(accessPath).data.get('isPremium', false) == true
        && get(accessPath).data.get('featureSet', []).hasAny(['circle_v1'])
        && get(accessPath).data.get('leaseValidUntil', null) is timestamp
        && request.time < get(accessPath).data.leaseValidUntil;
    }

    function hasValidCirclePreview(groupId) {
      let previewPath = /databases/$(database)/documents/groupPreviews/$(groupId);
      return exists(previewPath)
        && get(previewPath).data.get('schemaVersion', 0) == 1
        && get(previewPath).data.get('groupId', '') == groupId
        && get(previewPath).data.get('featureSet', []).hasAny(['circle_v1'])
        && get(previewPath).data.get('startedAt', null) is timestamp
        && get(previewPath).data.get('validUntil', null) is timestamp
        && get(previewPath).data.startedAt <= request.time
        && get(previewPath).data.validUntil
          <= get(previewPath).data.startedAt + duration.value(14, 'd')
        && request.time < get(previewPath).data.validUntil;
    }

    function hasCircleAccess(groupId) {
      return hasValidPaidGroupAccess(groupId) || hasValidCirclePreview(groupId);
    }

    function isIsoDateOrBlank(value) {
      return value is string
        && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function isIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // An ISO date that is "today" somewhere on Earth right now. Local dates run
    // from UTC-12 to UTC+14, so a date D is current while server time is within
    // [D - 14h, D + 36h); an hour either side absorbs device clock drift. Used
    // where a date is part of a document ID, so that a future date cannot be
    // used to mint more of something rationed per day. Call only after
    // isIsoDate(value) has passed.
    function isNearToday(value) {
      let parts = value.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return request.time > day - duration.value(15, 'h')
        && request.time < day + duration.value(37, 'h');
    }

    // An ISO date that can be the start of somebody's current or last week
    // right now: not after today anywhere on Earth, not before last week
    // began anywhere. The group's weekStart is what the weekly finalizer keys
    // on (functions-weekly), and until 2026-10-13 any member could write any
    // date there: a future one finalized this week early and every later week
    // as missed, breaking the streak and spending its shields, and an ancient
    // one created a history week per write. Call after isIsoDate(value).
    function isRecentWeekStart(value) {
      let parts = value.split('-');
      let day = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
      return day < request.time + duration.value(15, 'h')
        && day > request.time - duration.value(9, 'd');
    }

    // The values WeekWindow writes: a DayOfWeek name, or blank on groups
    // created before the start day could be chosen.
    function isWeekStartDay(value) {
      return value in ['', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY',
                       'FRIDAY', 'SATURDAY', 'SUNDAY'];
    }

    // A photoUrl is rendered by Coil on every other member's device, so an
    // arbitrary URL here is an attacker-chosen fetch from each viewer's phone:
    // their IP, their approximate location and the moment they opened the
    // screen, delivered to a host of somebody else's choosing. Length was the
    // only thing checked until 2026-08-25.
    //
    // Blank is the opted-out state and must stay legal. Everything else has to
    // be a download URL from this project's own bucket.
    //
    // Both forms are accepted deliberately. This project's bucket is
    // `pamoja-android-1ac6d.firebasestorage.app`, the newer style, and which of
    // the two shapes getDownloadUrl() returns is an SDK detail that has changed
    // before and is not worth betting every avatar upload on. Matching both
    // removes the silent-failure risk the single-host version carried, while
    // still refusing any host that is not Firebase Storage, which is the point:
    // an arbitrary URL here is an attacker-chosen fetch from every other
    // member's phone.
    function isOwnStorageUrl(url) {
      return url == ''
        || url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/[^/]+/o/.*')
        || url.matches('https://[^/]+[.]firebasestorage[.]app/.*');
    }

    function onlyChanged(allowedKeys) {
      return request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(allowedKeys);
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      // OWNER ONLY. Nobody can read anyone else's profile, including their age,
      // height and weight.
      //
      // Possible because member display names are denormalised onto the
      // membership documents, so rendering a leaderboard no longer needs to read
      // other people's user documents at all.
      allow read: if isSelf(userId);

      // Only the owner may write their own profile, and the document ID must
      // match their UID. This is what stops anyone editing another user.
      allow create, update: if isSelf(userId)
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40;

      allow delete: if isSelf(userId);
    }

    // ----------------------------------------------------------------- groups

    match /groups/{groupId} {
      // get: any signed-in user may read a group BY ID. Required for the invite
      //      flow, since you must read a group before you are a member of it.
      //      Group IDs are UUID v4 (122 bits), so they are not guessable.
      // list: DENIED. This is what stops anyone enumerating every group in the
      //      database. Possible because getGroupByInviteLink() now resolves by
      //      document ID instead of querying on the inviteLink field.
      allow get: if isSignedIn();
      allow list: if false;

      // The creator must be the admin, must start as the only member, and the
      // caps must be sane. Stops absurd or forged groups being created.
      allow create: if isSignedIn()
                    // GroupDto's fields and no others (1.0.x writes a subset).
                    // Any member's phone downloads this document on every
                    // change, so an open key set let a creator park up to a
                    // megabyte of anything on all of them.
                    && request.resource.data.keys().hasOnly([
                         'groupId', 'name', 'adminId', 'weeklyTarget',
                         'dailyPerPersonTarget', 'maxMemberCap', 'memberCount',
                         'canMembersEditTarget', 'inviteLink', 'inviteLinkActive',
                         'createdAt', 'weeklySteps', 'weekStart', 'weekStartDay',
                         'photoUrl', 'planningTimeZone', 'plannedWeekStart',
                         'streakWeeks', 'streakThroughWeek', 'streakShields',
                         'lastShieldedWeek'
                       ])
                    && request.resource.data.get('groupId', groupId) == groupId
                    // A deleted group's id is still the invite key in every
                    // link and QR code it ever shared; nobody may take it over.
                    // functions-notifications writes the tombstone.
                    && !exists(/databases/$(database)/documents/deletedGroups/$(groupId))
                    && isWeekStartDay(request.resource.data.get('weekStartDay', ''))
                    && request.resource.data.adminId == request.auth.uid
                    && request.resource.data.memberCount == 1
                    && request.resource.data.maxMemberCap >= 2
                    && request.resource.data.maxMemberCap <= 20
                    // A goal is one pooled weekly promise for the whole group.
                    // Presets are only UI shortcuts; a family may deliberately
                    // choose a custom total such as 300K.
                    && request.resource.data.weeklyTarget is int
                    && request.resource.data.weeklyTarget >= 10000
                    && request.resource.data.weeklyTarget <= 2800000
                    // This field remains in stored documents only so older app
                    // versions can be migrated safely. New groups must retire it.
                    && request.resource.data.get('dailyPerPersonTarget', 0) == 0
                    // Organizer-controlled. Older documents may carry true,
                    // but new clients never create that ambiguous permission.
                    && request.resource.data.get('canMembersEditTarget', false) == false
                    && request.resource.data.get('planningTimeZone', '') == ''
                    && request.resource.data.get('plannedWeekStart', '') == ''
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    // Case B validates photoUrl and Case E bounds the step
                    // cache; create validated neither, so everything an admin
                    // was stopped from doing later could simply be baked in at
                    // creation instead. `allow get` hands this document to any
                    // signed-in user, so an unbounded string here is one they
                    // serve to other people. CreateGroupUseCase writes "" and 0
                    // for all three, so none of this constrains the app.
                    && request.resource.data.get('photoUrl', '') is string
                    && request.resource.data.get('photoUrl', '').size() <= 500
                    && isOwnStorageUrl(request.resource.data.get('photoUrl', ''))
                    && request.resource.data.get('weeklySteps', 0) is int
                    && request.resource.data.get('weeklySteps', 0) >= 0
                    && request.resource.data.get('weeklySteps', 0) <= 42000000
                    && isIsoDateOrBlank(request.resource.data.get('weekStart', ''))
                    // The group streak is written only by the weekly finalizer.
                    // No update case lists these keys, so clients can never move
                    // them later; this stops one being baked in at creation.
                    && request.resource.data.get('streakWeeks', 0) == 0
                    && request.resource.data.get('streakThroughWeek', '') == ''
                    // Streak shields, likewise the finalizer's alone. The app's
                    // group DTO writes the two it displays at their defaults;
                    // shieldsStarted is what tells the finalizer a group's
                    // shields have begun, and no client may ever set it.
                    && request.resource.data.get('streakShields', 0) == 0
                    && request.resource.data.get('lastShieldedWeek', '') == ''
                    && !request.resource.data.keys().hasAny(['shieldProgress', 'shieldsStarted']);

      allow update: if
        // A server-side group deletion marks the parent before removing its
        // children. No join, settings edit or step-cache write may race that
        // cleanup and recreate group-scoped data behind it.
        resource.data.get('deletionPending', false) == false
        &&
        // --- Case A: a JOIN. A signed-in user adds exactly themselves.
        //
        //     Pinned to exactly +1 since 2026-08-18. It used to permit ANY
        //     increase, justified in a comment here by joinGroup() backfilling
        //     legacy groups whose memberCount was 0. It never did that: no
        //     backfill has ever existed in the client, in any version. So the
        //     loosening bought nothing and cost something, because any signed-in
        //     user holding a groupId could walk the count straight up to the cap
        //     and close a group they were not even a member of. Group ids come
        //     from invite links, and `allow get` hands one to anybody signed in.
        //
        //     getAfter(), not exists(): the joiner's membership document is
        //     created in this same commit, so before the commit it is absent and
        //     exists() would refuse every genuine join. Reading the post-commit
        //     state is what ties this increment to somebody actually joining
        //     rather than a bare counter bump. Case D uses exists() because a
        //     leaver's membership IS still there when their transaction starts.
        //
        //     memberCount is written with FieldValue.increment(), so the value
        //     compared here is computed by the server against the current count,
        //     never a number the client worked out from an earlier read. That is
        //     what lets two people join at the same moment and both succeed:
        //     with absolute writes they both computed the same value, the first
        //     commit won, and the second was refused for "not increasing" a
        //     count it had read correctly a moment earlier.
        //
        //     !exists() as well since 2026-10-13. getAfter() alone is also true
        //     for somebody who is ALREADY a member, whose old membership is
        //     still there after the commit, so any member could raise the
        //     count by one per write until the group read as full and nobody
        //     could join it. The joiner's membership must be new.
        //
        //     The invite flag may only close, and only when this join fills
        //     the group, which is the one thing joinGroup() writes it for. It
        //     was free, so a joiner could switch the invite off for everyone
        //     after them, and the app refuses to join a group whose invite is
        //     off.
        (
          isSignedIn()
          && onlyChanged(['memberCount', 'inviteLinkActive'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.memberCount <= resource.data.maxMemberCap
          && !exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId))
          && getAfter(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId)).data.userId == request.auth.uid
          && (
               request.resource.data.get('inviteLinkActive', true) == resource.data.get('inviteLinkActive', true)
               || (request.resource.data.inviteLinkActive == false
                   && request.resource.data.memberCount >= resource.data.maxMemberCap)
             )
        )
        ||
        // --- Case B: the admin edits group settings. adminId can never change.
        //
        //     onlyChanged() added 2026-08-16, when the group editor made this
        //     path something an admin uses rather than something almost nothing
        //     called. Without it the clause permitted an admin to write ANY
        //     field except adminId, including memberCount and the weeklySteps
        //     cache, so a compromised or buggy client could set memberCount to
        //     0 and reopen a full group, or write an arbitrary step total.
        //     Handover is Case F, which is why adminId is not in this list.
        (
          isGroupAdmin(groupId)
          && onlyChanged([
               'name',
               'weeklyTarget',
               'dailyPerPersonTarget',
               'maxMemberCap',
               'canMembersEditTarget',
               'weekStartDay',
               'inviteLinkActive',
               'photoUrl'
             ])
          && request.resource.data.get('photoUrl', '') is string
          && request.resource.data.get('photoUrl', '').size() <= 500
          && isOwnStorageUrl(request.resource.data.get('photoUrl', ''))
          && request.resource.data.maxMemberCap >= 2
          && request.resource.data.maxMemberCap <= 20
          && request.resource.data.maxMemberCap >= resource.data.memberCount
          && request.resource.data.weeklyTarget is int
          && request.resource.data.weeklyTarget >= 10000
          && request.resource.data.weeklyTarget <= 2800000
          && request.resource.data.get('dailyPerPersonTarget', 0) == 0
          && request.resource.data.get('canMembersEditTarget', false) == false
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          // The server's reminders and finalizer read both of these.
          && isWeekStartDay(request.resource.data.get('weekStartDay', ''))
          && request.resource.data.get('inviteLinkActive', true) is bool
          // Keep an already-saved boundary stable until the promise is applied.
          && (request.resource.data.get('weekStartDay', '') == resource.data.get('weekStartDay', '')
            || !exists(/databases/$(database)/documents/groups/$(groupId)/planningSummary/current)
            || get(/databases/$(database)/documents/groups/$(groupId)/planningSummary/current).data.status != 'scheduled')
        )
        ||
        // --- Case D: LEAVING. The count comes down by exactly one and the
        //     freed slot revives the invite link.
        //
        //     Without this, account deletion is denied for everyone who is not
        //     the group admin, because Case A only ever permits an increase.
        //     That would leave the membership deleted and the count permanently
        //     too high.
        //
        //     exists() is evaluated against the pre-transaction state, so the
        //     caller's membership is still present at this point even though the
        //     same transaction is about to delete it. That is what proves they
        //     were actually a member rather than decrementing a stranger's group.
        //
        //     exists() ALONE is not enough, and that was the bug here until
        //     2026-08-25: it stays true for a member who is not leaving, so any
        //     member could send this same update repeatedly and walk memberCount
        //     down to zero while still sitting in the group. Proven on the
        //     emulator: two members, count driven 2 -> 0, both memberships still
        //     present, after which the cap bound nothing. !existsAfter() is the
        //     missing half, and the mirror of the getAfter() Case A uses to tie
        //     an increment to a real join.
        //
        //     The admin branch is separate because removeMember() deletes
        //     SOMEBODY ELSE's membership, so the caller's own survives the
        //     commit and !existsAfter() would refuse every removal. Allowing it
        //     for the admin is not a widening: they can already delete the whole
        //     group. Group size is not a paid feature either (see PlanLimits,
        //     where the size paywall was deliberately removed), so there is no
        //     revenue boundary here for an admin to move.
        //
        //     A leaver may reopen the invite (a slot just freed) but never
        //     close it; that was free too until 2026-10-13.
        (
          isSignedIn()
          && onlyChanged(['memberCount', 'inviteLinkActive'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.memberCount >= 0
          && (
               request.resource.data.get('inviteLinkActive', true) == true
               || request.resource.data.get('inviteLinkActive', true) == resource.data.get('inviteLinkActive', true)
             )
          && (
               (
                 exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId))
                 && !existsAfter(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId))
               )
               || isGroupAdmin(groupId)
             )
        )
        ||
        // --- Case E: a MEMBER publishes the cached weekly step total, so the
        //     home screen can show progress per group without reading every
        //     member's step entries for every group it lists.
        //
        //     Membership is checked explicitly rather than relying on isSignedIn().
        //     Any signed-in user can `get` a group by ID (the invite flow needs
        //     that), so without this a stranger who had seen an invite link could
        //     write an arbitrary total onto a group they do not belong to. It is
        //     display-only data, but it is the number the whole product is about.
        //
        //     Only the two cache keys may move, and the total may not be negative.
        //     Bounded above as well as below since 2026-08-25. A member's own
        //     row is capped at 2,100,000 in the memberships rule, but this
        //     aggregate had no ceiling at all, so any member could write an
        //     arbitrary total onto the number Home renders as the group's
        //     progress. 42,000,000 is the largest honest value the product can
        //     produce: the member cap of 20 at that same per-person ceiling.
        (
          isSignedIn()
          && onlyChanged(['weeklySteps', 'weekStart'])
          && request.resource.data.weeklySteps is int
          && request.resource.data.weeklySteps >= 0
          && request.resource.data.weeklySteps <= 42000000
          && isIsoDate(request.resource.data.weekStart)
          // The finalizer closes the week this marker moves away from, so it
          // has to be a week that is current or just ended. See
          // isRecentWeekStart.
          && isRecentWeekStart(request.resource.data.weekStart)
          && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + groupId))
        )
        ||
        // --- Case F: the ADMIN LEAVES and hands the group over.
        //
        //     Case B pins adminId to its current value, deliberately, so that
        //     nobody can promote themselves. That also made admin handover
        //     impossible, and account deletion therefore left the group with an
        //     adminId pointing at a Firebase Auth user that no longer existed.
        //     Nobody could then change the target, manage the invite link, or
        //     remove a member, for the lifetime of the group.
        //
        //     Narrow on purpose. Only the sitting admin can trigger it, the new
        //     admin must already hold a membership in this group, and the count
        //     comes down by exactly one because the outgoing admin is leaving in
        //     the same transaction. A group whose last member is the admin is
        //     deleted instead, which the delete rule below already permits.
        (
          isGroupAdmin(groupId)
          && onlyChanged(['adminId', 'memberCount', 'inviteLinkActive'])
          && request.resource.data.adminId != resource.data.adminId
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.memberCount >= 1
          && exists(/databases/$(database)/documents/memberships/$(request.resource.data.adminId + '_' + groupId))
        );

      allow delete: if isGroupAdmin(groupId);
    }

    // A completed week is the first Circle depth feature. It remains an
    // immutable server-owned record and is readable only while this current
    // member's group has a live server-owned Preview or paid lease. The basic
    // current-week progress and leaderboard remain free in their existing
    // documents. Checking membership also protects orphaned subcollections
    // after the parent group is deleted (Firestore does not cascade deletion).
    //
    // One exception, added with the Premium rework: the group's most recent
    // finished week is free to its members (this week and last are free, the
    // rest is Premium). streakThroughWeek is set by the same finalizer every
    // time a week is finalized, met or missed, so it always names that week.
    // A get only, authorised on the path and the group document, never on
    // resource.data, so asking for a week that does not exist is not an error.
    // Listing stays Premium: it would return every week.
    match /groups/{groupId}/weeks/{weekStart} {
      allow get: if isGroupMember(groupId)
                 && (hasCircleAccess(groupId)
                     || weekStart == get(/databases/$(database)/documents/groups/$(groupId)).data.get('streakThroughWeek', ''));
      allow list: if isGroupMember(groupId) && hasCircleAccess(groupId);
      allow create, update, delete: if false;
    }

    // Next Week Together is group-scoped paid coordination. Preview can read
    // history but cannot read or write plans. Only the organiser chooses the
    // shared target; each member can change only their own small availability
    // response. The server is solely responsible for marking a plan applied.
    // A saved goal is still a promise after a lease ends. This projection has
    // no historical totals, creator identity or member response counts.
    match /groups/{groupId}/planningSummary/{summaryId} {
      allow get: if summaryId == 'current' && isGroupMember(groupId);
      allow list, create, update, delete: if false;
    }

    match /groups/{groupId}/nextWeekPlans/{planWeekStart} {
      function validPlanningBasis() {
        let d = request.resource.data;
        // New planning is admitted by the callable's server clock. Once a
        // group opts in, an older app cannot overwrite its shared promise.
        return !exists(/databases/$(database)/documents/groupPlanning/$(groupId))
          && d.schemaVersion == 1
            && isIsoDate(d.sourceWeekStart)
            && d.basisTotalSteps is int
            && d.basisTotalSteps >= 0 && d.basisTotalSteps <= 42000000;
      }
      function responseWindowOpen() {
        let plan = get(/databases/$(database)/documents/groups/$(groupId)/nextWeekPlans/$(planWeekStart)).data;
        return plan.status == 'scheduled' &&
          (plan.schemaVersion == 1 || (plan.schemaVersion == 2 && request.time < plan.appliesAt));
      }
      allow get, list: if isGroupMember(groupId) && hasValidPaidGroupAccess(groupId);

      allow create: if isGroupAdmin(groupId)
        && hasValidPaidGroupAccess(groupId)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'groupId', 'weekStart', 'targetSteps', 'choice',
          'sourceWeekStart', 'basisTotalSteps', 'basisTargetSteps', 'status',
          'createdBy', 'createdAt', 'updatedAt', 'inCount',
          'preferGentlerCount', 'restingCount'
        ])
        && validPlanningBasis()
        && request.resource.data.groupId == groupId
        && request.resource.data.weekStart == planWeekStart
        && isIsoDate(planWeekStart)
        && request.resource.data.targetSteps is int
        && request.resource.data.targetSteps >= 10000
        && request.resource.data.targetSteps <= 2800000
        && request.resource.data.choice in ['repeat', 'gentler', 'custom']
        && request.resource.data.basisTargetSteps is int
        && request.resource.data.basisTargetSteps >= 0
        && request.resource.data.basisTargetSteps <= 2800000
        && request.resource.data.status == 'scheduled'
        && request.resource.data.inCount == 0
        && request.resource.data.preferGentlerCount == 0
        && request.resource.data.restingCount == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isGroupAdmin(groupId)
        && hasValidPaidGroupAccess(groupId)
        && resource.data.status == 'scheduled'
        && onlyChanged([
          'targetSteps', 'choice', 'sourceWeekStart', 'basisTotalSteps',
          'basisTargetSteps', 'updatedAt', 'schemaVersion'
        ])
        && validPlanningBasis()
        && request.resource.data.schemaVersion >= resource.data.schemaVersion
        && request.resource.data.groupId == groupId
        && request.resource.data.weekStart == planWeekStart
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'scheduled'
        && request.resource.data.targetSteps is int
        && request.resource.data.targetSteps >= 10000
        && request.resource.data.targetSteps <= 2800000
        && request.resource.data.choice in ['repeat', 'gentler', 'custom']
        && request.resource.data.basisTargetSteps is int
        && request.resource.data.basisTargetSteps >= 0
        && request.resource.data.basisTargetSteps <= 2800000
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /responses/{userId} {
        // Availability answers are private. Everyone sees only server-maintained
        // aggregate counts on the plan; a member can read back their own answer.
        allow get: if isSelf(userId)
          && isGroupMember(groupId)
          && hasValidPaidGroupAccess(groupId);
        allow list: if false;

        allow create: if isSelf(userId)
          && isGroupMember(groupId)
          && hasValidPaidGroupAccess(groupId)
          && responseWindowOpen()
          && request.resource.data.keys().hasOnly([
            'schemaVersion', 'groupId', 'weekStart', 'userId', 'response',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.groupId == groupId
          && request.resource.data.weekStart == planWeekStart
          && request.resource.data.userId == userId
          && request.resource.data.response in ['in', 'prefer_gentler', 'resting']
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isSelf(userId)
          && isGroupMember(groupId)
          && hasValidPaidGroupAccess(groupId)
          && responseWindowOpen()
          && onlyChanged(['response', 'updatedAt'])
          && request.resource.data.schemaVersion == 1
          && request.resource.data.groupId == groupId
          && request.resource.data.weekStart == planWeekStart
          && request.resource.data.userId == userId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.response in ['in', 'prefer_gentler', 'resting']
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }
    }

    // Cheers and nudges, one collection with `kind`, so Home needs two
    // listeners (what I sent today, what I received today) rather than four.
    //
    // Private to the two people involved. Nobody else in the group can see who
    // nudged whom, which matters more for nudges than for cheers: a list of who
    // was nudged is a list of who is falling behind.
    //
    // The ID is {date}_{kind}_{fromUid}_{toUid} and a signal can only ever be
    // created, never rewritten. That makes "one cheer and one nudge per person
    // per day" a property of the ID rather than a counter anybody can race, and
    // isNearToday stops a future date from being used to mint more. Firebase
    // UIDs are alphanumeric, so the underscores are unambiguous.
    //
    // No names or photos are stored: the reader already has both from the
    // memberships it loaded, and a copy here would go stale on a rename.
    // functions-notifications pushes on create and stamps expireAt for a TTL
    // policy, which is why expireAt is not a client-writable key.
    match /groups/{groupId}/signals/{signalId} {
      allow list: if isGroupMember(groupId)
                  && (
                       ('fromUserId' in resource.data
                         && resource.data.fromUserId == request.auth.uid)
                       ||
                       ('toUserId' in resource.data
                         && resource.data.toUserId == request.auth.uid)
                     );
      allow get, update, delete: if false;

      allow create: if isGroupMember(groupId)
                    && request.resource.data.keys().hasOnly([
                         'kind', 'fromUserId', 'toUserId', 'date', 'createdAt'
                       ])
                    && request.resource.data.kind in ['cheer', 'nudge']
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.toUserId is string
                    && request.resource.data.toUserId != request.auth.uid
                    && isIsoDate(request.resource.data.date)
                    // Checked before the path below is built from toUserId: a
                    // document ID cannot contain '/', so this also keeps that
                    // path to exactly one membership.
                    && signalId == request.resource.data.date + '_'
                         + request.resource.data.kind + '_'
                         + request.auth.uid + '_'
                         + request.resource.data.toUserId
                    && exists(/databases/$(database)/documents/memberships/$(request.resource.data.toUserId + '_' + groupId))
                    && request.resource.data.createdAt == request.time
                    && isNearToday(request.resource.data.date);
    }

    // ------------------------------------------------------------ memberships

    match /memberships/{membershipId} {
      // The day dots in a group's standings. walkedDays has one bit per day of
      // the group's week (bit 0 is its first day) set when that day reached
      // 1,000 steps; walkedWeekStart names the week, and a reader shows the
      // dots only when it matches the current one. A marker of its own rather
      // than weekStart, because older app versions keep moving weekStart
      // without knowing this field exists.
      //
      // Read with defaults, never required. Versions before 2026-10 do not
      // write either key, and their updates must keep passing: onlyChanged
      // ignores keys they leave alone, and a document without the fields
      // validates as 0 and "".
      function validWalkedDays() {
        return request.resource.data.get('walkedDays', 0) is int
          && request.resource.data.get('walkedDays', 0) >= 0
          && request.resource.data.get('walkedDays', 0) <= 127
          && isIsoDateOrBlank(request.resource.data.get('walkedWeekStart', ''));
      }

      // `read` used to cover both of these with a bare isSignedIn(), and `read`
      // means get AND list. Groups were protected with `allow list: if false`
      // and users with isSelf(), but this collection was left open, so any
      // account that had just signed up could run an unfiltered query and read
      // every user's display name, photo URL and group memberships. Proven on
      // the emulator on 2026-08-18, not inferred. Left over from the
      // `allow read, write: if true` this file's header says it replaced.

      // Single document by ID. Deliberately still a bare isSignedIn(), and it
      // must stay that way: joinGroup() reads the joiner's own membership
      // before creating it, to make a repeated join idempotent, so this rule is
      // evaluated against a document that does not exist yet. Any condition
      // touching resource.data would raise an evaluation error there and break
      // every join. The ID is "{uid}_{groupId}", so reading one already means
      // knowing both, which is a far cry from enumerating the collection.
      //
      // Bare isSignedIn() was still too wide, and stopped being it on
      // 2026-10-13. The group document names its adminId and anyone holding
      // the invite may read that document, so anyone with a forwarded link
      // could read the starter's membership: name, photo and live step
      // figures, without joining. Now: your own membership, or one in a group
      // you are in (which `list` already shows you). Authorised on the ID,
      // never resource.data, for the reason above. UIDs are alphanumeric and
      // group ids are UUIDs, so the split is exact.
      allow get: if isSignedIn()
                 && (
                      membershipId.split('_')[0] == request.auth.uid
                      || isGroupMember(membershipId.split('_')[1])
                    );

      // Queries. A list rule is NOT evaluated against fetched documents: it is
      // checked against what the query itself constrains, so it may only refer
      // to fields the query actually filters on. Referring to any other field
      // fails the whole query with "Property X is undefined on object", which
      // is what a first attempt at this rule did to getUserGroups.
      //
      // This collection is queried two ways, and each proves membership using
      // only the field it filters on:
      //
      //   - by groupId: getGroupMembers, and the successor search during
      //     account deletion. Permitted if the caller holds a membership in
      //     that group
      //   - by userId: getUserGroups, the profile fan-out, data export and
      //     account deletion. Permitted only for the caller's own id, so every
      //     document returned is their own membership
      //
      // Each side is guarded with `in` rather than dereferenced directly,
      // because the field the OTHER query filters on is absent here and reading
      // it would raise an error instead of yielding false. `in` yields false and
      // lets the disjunction fall through to the side that applies.
      //
      // An unfiltered dump constrains neither field, so both sides are false and
      // the query is refused. That is the hole this closes.
      //
      // The join preview is unaffected: it resolves a group with a get and never
      // lists members before joining.
      allow list: if isSignedIn()
                  && (
                       ('userId' in resource.data
                         && resource.data.userId == request.auth.uid)
                       ||
                       ('groupId' in resource.data
                         && exists(/databases/$(database)/documents/memberships/$(request.auth.uid + '_' + resource.data.groupId)))
                     );

      // Membership IDs are deterministic "{uid}_{groupId}". Pinning the write
      // to that pattern makes forging a membership for someone else impossible.
      // displayName is validated with get(..., '') rather than required to
      // exist. Requiring the field made this rule reject any client that did
      // not write it, which broke group creation outright. It is a display
      // string, so only its length is worth enforcing, never its presence.
      //
      // What the ID pattern does NOT do, and what was missing here until
      // 2026-08-25, is tie the membership to the group's own accounting. The
      // rule asked only "is this document named after you", so any signed-in
      // user holding a groupId could write themselves straight into a group: no
      // cap check, no invite check, memberCount untouched. Proven on the
      // emulator: 30 accounts inserted into a group whose cap was 2 and whose
      // memberCount stayed at 1, each of them then passing the `list` rule below
      // and reading the whole roster with everyone's live step figures. Group ids
      // come from invite links, and links get forwarded.
      //
      // So the create is now bound to one of the two commits that legitimately
      // produce a membership:
      //
      //   - createGroup(), where the caller is the group's admin. The group
      //     document is written first and separately, so get() and getAfter()
      //     agree here and adminId is what authorises it.
      //   - joinGroup(), where the SAME transaction raises memberCount by one.
      //     Case A above independently bounds that increment against
      //     maxMemberCap, so the cap now gates the membership too.
      //
      // joinedAt is floored at the group's creation time because
      // deleteAllUserData() picks the successor admin with
      // minByOrNull { joinedAt }: an unvalidated joinedAt of 0 makes the writer
      // the permanent front-runner for inheriting the group. get(..., 0) on
      // createdAt rather than a bare dereference, because groups written before
      // that field existed decode as 0 and a missing field raises an evaluation
      // error rather than yielding false.
      //
      // The key set is MembershipDto's (1.0.x writes a subset), because every
      // member's leaderboard downloads this document: an open key set let a
      // joiner park a megabyte on all of them. Only the group's admin may
      // carry the admin role and target permission, which nothing authorises
      // on but which other members' apps display.
      allow create: if isSignedIn()
                    && membershipId == request.auth.uid + '_' + request.resource.data.groupId
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'userId', 'groupId', 'displayName', 'role',
                         'canEditTarget', 'photoUrl', 'joinedAt', 'weeklySteps',
                         'weekStart', 'todaySteps', 'todayDate', 'walkedDays',
                         'walkedWeekStart'
                       ])
                    && (
                         (request.resource.data.get('role', 'member') == 'member'
                           && request.resource.data.get('canEditTarget', false) == false)
                         ||
                         getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                           .data.adminId == request.auth.uid
                       )
                    && request.resource.data.get('displayName', '') is string
                    && request.resource.data.get('displayName', '').size() <= 100
                    && request.resource.data.get('photoUrl', '') is string
                    && request.resource.data.get('photoUrl', '').size() <= 500
                    && isOwnStorageUrl(request.resource.data.get('photoUrl', ''))
                    && request.resource.data.get('weeklySteps', 0) is int
                    && request.resource.data.get('weeklySteps', 0) >= 0
                    && request.resource.data.get('weeklySteps', 0) <= 2100000
                    && request.resource.data.get('todaySteps', 0) is int
                    && request.resource.data.get('todaySteps', 0) >= 0
                    && request.resource.data.get('todaySteps', 0) <= 300000
                    && isIsoDateOrBlank(request.resource.data.get('weekStart', ''))
                    && isIsoDateOrBlank(request.resource.data.get('todayDate', ''))
                    && validWalkedDays()
                    && request.resource.data.get('joinedAt', 0) is int
                    && request.resource.data.get('joinedAt', 0) >=
                         get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                           .data.get('createdAt', 0)
                    && (
                         getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                           .data.adminId == request.auth.uid
                         ||
                         getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                           .data.memberCount ==
                         get(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                           .data.memberCount + 1
                       );

      // A member may not silently promote themselves to admin. They may update
      // their own displayName and photoUrl, which is what the profile fan-out
      // does.
      //
      // photoUrl is the denormalised copy that makes leaderboard avatars
      // possible without reading users/{userId}, which stays owner-only. It is
      // only ever written by its owner, so nobody can attach an image to
      // somebody else's row. Length-capped because it is a URL, not a payload.
      // weeklySteps / todaySteps are the leaderboard figures, published here by
      // the member's own device after a sync. They moved onto this document
      // because reading them from the steps collection could not be secured, so
      // they are bounded here in the same way a step entry is: this is now the
      // number a leaderboard displays, and an unbounded one would be a cheat
      // written straight to the scoreboard.
      //
      // 300k matches the per-day ceiling on a step entry, and the weekly ceiling
      // is seven of those. Neither is a plausible human figure; both exist to
      // stop an absurd one.
      //
      // onlyChanged() added 2026-08-25. Pinning userId and role field by field
      // left every OTHER field free, groupId included, so a member could point
      // their own membership document at a different group and appear on that
      // group's leaderboard with a weeklySteps of 2,100,000 without ever having
      // joined it. Proven on the emulator. The same gap left joinedAt rewritable
      // after the fact, which is the successor-admin ordering. Listing the keys
      // is both tighter and shorter than pinning the rest one at a time, and it
      // is what Case B on groups already does.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.role == resource.data.role
                    && onlyChanged([
                         'displayName',
                         'photoUrl',
                         'weeklySteps',
                         'weekStart',
                         'todaySteps',
                         'todayDate',
                         'walkedDays',
                         'walkedWeekStart'
                       ])
                    && request.resource.data.get('displayName', '') is string
                    && request.resource.data.get('displayName', '').size() <= 100
                    && request.resource.data.get('photoUrl', '') is string
                    && request.resource.data.get('photoUrl', '').size() <= 500
                    && isOwnStorageUrl(request.resource.data.get('photoUrl', ''))
                    && request.resource.data.get('weeklySteps', 0) is int
                    && request.resource.data.get('weeklySteps', 0) >= 0
                    && request.resource.data.get('weeklySteps', 0) <= 2100000
                    && request.resource.data.get('todaySteps', 0) is int
                    && request.resource.data.get('todaySteps', 0) >= 0
                    && request.resource.data.get('todaySteps', 0) <= 300000
                    && isIsoDateOrBlank(request.resource.data.get('weekStart', ''))
                    && isIsoDateOrBlank(request.resource.data.get('todayDate', ''))
                    && validWalkedDays();

      // Removing yourself has to bring the group's count down in the same
      // commit, unless the group is gone (or going in this commit) or the count
      // is already zero. Those are the only shapes leaving, account deletion
      // and handover ever take. Until 2026-10-13 a bare self-delete was
      // allowed, so anyone holding an invite could join, delete their own
      // membership, join again, and walk the count to the cap with nobody in
      // the group: closed to every real joiner, with a "joined" push to every
      // member on each lap. Case A's increment is matched here by the
      // decrement.
      function leavesTheCountRight(groupId) {
        let group = /databases/$(database)/documents/groups/$(groupId);
        return !existsAfter(group)
          || get(group).data.get('memberCount', 0) <= 0
          || getAfter(group).data.get('memberCount', 0) == get(group).data.get('memberCount', 0) - 1;
      }

      // Remove yourself, or the group admin may remove anyone.
      allow delete: if isSignedIn()
                    && (
                         (resource.data.userId == request.auth.uid
                           && leavesTheCountRight(resource.data.groupId))
                         || isGroupAdmin(resource.data.groupId)
                       );
    }

    // --------------------------------------------------------- paid access

    // This is the only group-level billing projection the app may read. It
    // contains no payer identity, receipt, product or RevenueCat metadata.
    // Access is inherited by every current group member and cannot be forged by
    // any client, including the group admin or the payer.
    match /groupAccess/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list, create, update, delete: if false;
    }

    // One group-owned, one-time product Preview. It contains only feature and
    // timing metadata, never payer or member identity. The weekly-history
    // function creates it after the first week with two active members; no
    // client can start it later or reset its clock.
    match /groupPreviews/{groupId} {
      allow get: if isGroupMember(groupId);
      allow list, create, update, delete: if false;
    }

    // A payer may see their own minimal billing projection. Canonical customer,
    // receipt and sponsor records remain server-only below.
    match /billingViews/{userId} {
      allow get: if isSelf(userId);
      allow list, create, update, delete: if false;
    }

    // The Admin SDK in Cloud Functions bypasses Firestore rules. No mobile or
    // web client can read or write these canonical billing collections.
    match /billingAccounts/{userId} {
      allow read, write: if false;
    }

    match /groupBilling/{groupId} {
      allow read, write: if false;
    }

    match /revenueCatEvents/{eventId} {
      allow read, write: if false;
    }

    // The callable Functions backend owns every write to delivery credentials.
    // An owner-scoped read exists solely so Download my data can disclose the
    // identifiers held for this account. Firestore will permit a list only when
    // the query constrains userId to request.auth.uid, so this is not enumerable.
    match /pushRegistrations/{installationId} {
      allow get, list: if isSignedIn()
                       && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------ steps

    match /steps/{stepId} {
      // Your own step history, and nobody else's.
      //
      // This said `allow read: if isSignedIn()` until 2026-08-19, and `read`
      // covers `list`, so any account that had just signed up could run an
      // unfiltered query and take every user's daily step counts. Proven on the
      // emulator rather than inferred. The same leftover as memberships, from
      // the `allow read, write: if true` this file's header says it replaced.
      //
      // It could not be fixed by tightening the rule alone. The leaderboard used
      // to query `whereIn("userId", memberIds)` over the whole collection, and a
      // list rule is checked against what the query constrains, so it may only
      // refer to fields the query filters on. That query named no group at all,
      // which left no way to express "these people share a group with me" and
      // therefore no rule that could permit it without permitting everything.
      //
      // So the query is gone. Each member now publishes their own weekly and
      // daily totals onto their own membership document, and the leaderboard
      // reads those, which are already restricted to that group's members. This
      // collection is once again private to the person it describes, and the
      // only readers left are that user's own export and deletion.
      // Authorised on the document ID, not on the document's contents, because
      // a get for a day with no steps has no contents to read. Testing
      // `resource.data.userId` there raises an evaluation error rather than
      // returning false, so asking "do I have steps for this date" would come
      // back PERMISSION_DENIED instead of empty. `resource != null` does not
      // save it. Same shape of trap as the memberships get rule.
      //
      // Reading the ID is exactly as strict: the create rule below pins the ID
      // to `{uid}_{date}` and the data's userId to the same uid, so the two can
      // never disagree. Firebase UIDs are alphanumeric, so the segment before
      // the first underscore is the whole uid.
      allow get: if isSignedIn()
                 && stepId.split('_')[0] == request.auth.uid;

      // A list, by contrast, only ever sees documents that exist, and userId is
      // the field every remaining query filters on.
      allow list: if isSignedIn()
                  && resource.data.userId == request.auth.uid;

      // You may only ever write YOUR OWN step data, the document ID must match
      // your UID, and the value must be a sane non-negative integer.
      // This is what stops someone writing 999,999,999 steps to win, or
      // fabricating step history for another user.
      //
      // NOTE: the field is `stepCount` (see StepEntryDto), NOT `steps`.
      // Referencing a non-existent field makes the whole condition fail and
      // silently denies every write.
      allow create, update: if isSignedIn()
                            && stepId == request.auth.uid + '_' + request.resource.data.date
                            // Only real days. The server reads steps by
                            // {uid}_{date} for real dates, so anything else
                            // was an unbounded pile of documents nothing reads.
                            && isIsoDate(request.resource.data.date)
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.stepCount is int
                            && request.resource.data.stepCount >= 0
                            && request.resource.data.stepCount <= 300000;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------- deny by default
    // Anything not explicitly matched above is denied. NEVER remove this.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ============================================================================
// WHAT THIS FIXES IMMEDIATELY
//   ✅ Unauthenticated public access, completely closed
//   ✅ Writing to another user's profile, blocked
//   ✅ Writing another user's step data, blocked
//   ✅ Fabricating step counts to win the leaderboard, bounded 0..300000
//   ✅ Forging group memberships, blocked by the ID pattern
//   ✅ Promoting yourself to admin, blocked
//   ✅ Deleting another user's group, blocked
//   ✅ Creating groups with absurd member caps, bounded 2..20
//
// ---------------------------------------------------------------------------
// PHASE 2 HARDENING, requires two small code changes, do after launch prep
//
//   1. DONE. `list` on groups is now denied. getGroupByInviteLink() resolves by
//      document ID rather than querying the inviteLink field, so enumeration of
//      the groups collection is closed.
//
//   2. DONE. users/{userId} is owner-only. Member display names are denormalised
//      onto membership documents, so nothing reads another person's profile and
//      age/height/weight are no longer reachable by anyone but the owner.
//
//   3. DONE. `steps` is owner-only, on both get and list. The get rule authorises
//      on the document ID because a day with no steps has no contents to read;
//      see the rule itself. Weekly and daily totals are denormalised onto the
//      membership documents, which is what removed the last cross-user read.
//
//   4. DONE in the client: PamojaApp.initializeAppCheck() installs Play Integrity
//      in release and the debug provider in debug. Installing the provider is
//      NOT enforcement. Nothing is rejected until App Check enforcement is
//      switched on per-service in the Firebase console, and the debug token must
//      be registered before it is, or every development build starts failing
//      every Firestore call. Confirm the console state; this file cannot.
//
//   5. STALE, removed. This said Case A let a signed-in user increment the count
//      without joining. It has not since getAfter() was added on 2026-08-18: the
//      increment is refused unless the joiner's membership exists after the
//      commit. Left standing, a wrong sentence in this file is exactly how the
//      August 2026 memberCount hole was justified in the first place.
// ============================================================================

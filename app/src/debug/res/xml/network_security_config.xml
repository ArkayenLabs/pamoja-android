<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Never merged into release.

  The emulator-backed integration tests talk to the Firebase Auth and Firestore
  emulators over plaintext HTTP, which targetSdk 28+ blocks by default. Scoped
  to the loopback hosts instead of enabling cleartext wholesale: 10.0.2.2 is the
  host machine as seen from inside an Android emulator.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

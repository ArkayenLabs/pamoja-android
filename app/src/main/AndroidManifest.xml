<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Health Connect, replaces raw ACTIVITY_RECOGNITION sensor approach -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The Advertising ID permission arrives on its own, from
      com.google.android.gms:play-services-measurement-api, pulled in by
      firebase-analytics. It is not declared above and never was: the source
      manifest asks for three permissions and the MERGED manifest shipped nine.

      Removed, because every document this project has already filed says the
      app does not do this. legal/PRIVACY_POLICY.md states "Pamoja contains no
      advertising" and that Health Connect data is "never used for advertising
      or marketing", and legal/DATA_SAFETY.md's "Device or other IDs" row cites
      only the Firebase instance, Installations and FCM identifiers. Nothing in
      app/src references AdvertisingId, AD_ID or adservices. Shipping an
      undisclosed advertising identifier alongside health data is a rejection
      cause during review and a removal cause after it.

      Firebase Analytics keeps working; it loses ad-ID-based attribution, which
      this app does not use.

      Check the MERGED manifest, not this file, before an upload:
        app/build/intermediates/merged_manifest/release/processReleaseMainManifest/AndroidManifest.xml
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <!-- Required so Android allows our app to talk to the Health Connect app -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".PamojaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pamoja">

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>

        <!--
          FCM's current registration model targets the Firebase Installation
          ID rather than a legacy registration token. The service below owns
          both registration callbacks and data-message rendering so the same
          channels, privacy, and deep-link rules apply in every app state.
        -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/pamoja_brand" />

        <service
            android:name=".notifications.PamojaFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widgets.TodayStepsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_steps_info" />
        </receiver>

        <receiver
            android:name=".widgets.GroupProgressWidgetProvider"
            android:exported="false"
            android:label="@string/widget_group_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_group_progress_info" />
        </receiver>

        <receiver
            android:name=".widgets.WalkHookWidgetProvider"
            android:exported="false"
            android:label="@string/widget_hook_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_walk_hook_info" />
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Pamoja.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- ── Android App Links: invite links ──────────────────────────
                 Verified against https://www.arkayenlabs.com/.well-known/assetlinks.json
                 (and the apex host). Because these are VERIFIED https links, no
                 other app can hijack them and no disambiguation dialog appears.

                 IMPORTANT: assetlinks.json must be served directly at BOTH hosts
                 with no redirect. Google's verifier does not follow redirects.
                 If the apex redirects to www, remove the apex <data> entry. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="www.arkayenlabs.com"
                      android:pathPrefix="/pamoja/join" />
                <!-- The apex host (arkayenlabs.com) is deliberately NOT declared.
                     It 307-redirects to www, and Google's App Link verifier does
                     not follow redirects, so declaring it would leave a host that
                     can never verify. All generated links use www. -->

            </intent-filter>

            <!-- ── Legacy custom scheme ─────────────────────────────────────
                 Kept only so invite links already shared during the closed test
                 continue to work. Custom schemes are hijackable by any app, so
                 all NEW links use the verified https form above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pamoja" android:host="join" />
            </intent-filter>
        </activity>

        <activity-alias
        android:name="ViewPermissionUsageActivity"
        android:exported="true"
        android:targetActivity=".MainActivity"
        android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Remove the default WorkManager initializer. Hilt handles it via on-demand init -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.trailcards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/trail_share_paths" />
        </provider>
    </application>

</manifest>

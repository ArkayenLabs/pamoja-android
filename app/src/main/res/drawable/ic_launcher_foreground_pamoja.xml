<?xml version="1.0" encoding="utf-8"?>
<!--
  The Pamoja mark, as the launcher icon foreground.

  Geometry and colours are not invented here: they are the exact math from
  PamojaRingMark.kt (radius = w*16.5/64, stroke = w*6.5/64, centers at
  x = w*24.5/64 and w*39.5/64, both at y = w*32/64), translated from that
  64-unit drawing space onto the 108dp adaptive icon canvas by +22dp in both
  axes, which centres it exactly on the canvas centre (54,54).

  Kept inside Android's 66dp safe-zone circle: the ring pair's farthest bounding
  corner sits 29.1dp from the mark's own centre, leaving 3.9dp of margin before
  any launcher mask (circle, squircle, rounded square) could crop it.

  Colours are the light-theme brand tokens from Color.kt: ember Brand600
  #C34A21, jade Teal600 #0E8563. Fixed rather than theme-aware on purpose, since
  an adaptive icon's foreground is one static asset, not a Composable; the
  background colour below is chosen to give both rings the same contrast the
  light theme's own surface gives them in-app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M46.5,54m-16.5,0a16.5,16.5 0,1 1,33 0a16.5,16.5 0,1 1,-33 0"
        android:strokeColor="#C34A21"
        android:strokeWidth="6.5"
        android:fillColor="#00000000" />
    <path
        android:pathData="M61.5,54m-16.5,0a16.5,16.5 0,1 1,33 0a16.5,16.5 0,1 1,-33 0"
        android:strokeColor="#0E8563"
        android:strokeWidth="6.5"
        android:fillColor="#00000000" />
</vector>
